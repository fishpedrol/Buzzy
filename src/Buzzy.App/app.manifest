<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="0.1.0.0" name="Buzzy.app" />

  <!-- Sem elevação (SECURITY.md 2 e 8, item 5): nenhum recurso do Buzzy exige administrador. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!--
        Windows 10 (versão 1607 ou mais recente) e Windows 11, que compartilham este GUID (DEC-043; Q-02 revista). Sem ele,
        o Windows informa ao aplicativo a versão do Windows 8 e aplica o comportamento de compatibilidade dela. O portão
        exige esta declaração (VerificadorDeManifesto).
      -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    Per-Monitor V2 declarado no manifesto, não por chamada de função (ARCHITECTURE.md 2.4
    e 2.13.3). dpiAware fica como recuo para quem só entende o esquema antigo.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>

</assembly>
