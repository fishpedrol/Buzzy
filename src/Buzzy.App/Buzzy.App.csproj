<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App WPF do Buzzy. Toda chamada ao Windows fica em Plataforma/; o comportamento puro
    fica em Buzzy.Core. Nenhum pacote NuGet.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Buzzy</AssemblyName>
    <RootNamespace>Buzzy.App</RootNamespace>
    <Version>0.1.3</Version>
    <Product>Buzzy</Product>
    <!-- As licenças da Microsoft pedem o aviso de copyright no programa. -->
    <Copyright>Copyright (c) 2026 fishpedrol. Todos os direitos reservados.</Copyright>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Janela e aplicação montadas em código, sem XAML, pra ficar fácil de auditar. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Buzzy.App.Programa</StartupObject>

    <!-- Per-Monitor V2 e asInvoker vêm do manifesto. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    -p:BuzzyEdicao=publica tira as drogas ilícitas (ver Composicao\EdicaoDoBuild.cs).
    Vazio ou "completa" é a edição normal; qualquer outro valor quebra o build.
  -->
  <PropertyGroup Condition="'$(BuzzyEdicao)' == 'publica'">
    <DefineConstants>$(DefineConstants);BUZZY_PUBLICO</DefineConstants>
  </PropertyGroup>
  <Target Name="BuzzyConferirEdicao" BeforeTargets="CoreCompile">
    <Error Condition="'$(BuzzyEdicao)' != '' and '$(BuzzyEdicao)' != 'completa' and '$(BuzzyEdicao)' != 'publica'"
           Text="BuzzyEdicao='$(BuzzyEdicao)' desconhecida: use publica ou completa (DEC-044)." />
  </Target>

  <!--
    .exe único autocontido do download: só com -p:BuzzyExeUnico=true (tools\empacotar.ps1 -Formato exe).
    O RuntimeIdentifier fica aqui, não na linha de comando, senão vira propriedade global e vaza pras
    ferramentas referenciadas. Na primeira execução o .NET extrai as 5 DLLs nativas do WPF em
    %TEMP%\.net\Buzzy (IncludeNativeLibrariesForSelfExtract); essa escrita é aceita de propósito.
  -->
  <PropertyGroup Condition="'$(BuzzyExeUnico)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Lockfile separado: assim o build comum não ganha o grafo win-x64 nem baixa pacotes de runtime.
      Só o publish do .exe precisa deles, e o restore travado confere este arquivo.
    -->
    <NuGetLockFilePath>packages.win-x64.lock.json</NuGetLockFilePath>
    <!-- Só os dois frameworks usados; evita o runtime do ASP.NET Core na conferência de procedência do portão. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      O analisador de arquivo único puxaria o pacote Microsoft.NET.ILLink.Tasks, e aqui é zero pacote.
      O que ele pegaria (Assembly.Location, GetFile, CodeBase, vazios num arquivo único) o portão
      confere no IL (BZP001, categoria Arquivo único).
    -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- Portão e validador de clipes só rodam no build (ReferenceOutputAssembly=false); não entram no pacote. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Buzzy.Core\Buzzy.Core.csproj" />
    <!-- Pixel art: o sprite e o ícone da bandeja. -->
    <ProjectReference Include="..\Buzzy.Visual\Buzzy.Visual.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Buzzy.App.Testes" />
    <!-- Manifesto de clipes embutido; conferido pela validação depois do build. -->
    <EmbeddedResource Include="Apresentacao\clipes.json" LogicalName="Buzzy.App.Apresentacao.clipes.json" />
  </ItemGroup>

  <!--
    Portão de APIs proibidas, roda depois de cada build. A referência só garante que ele
    compile antes; o assembly dele não entra no Buzzy. Violação ou erro de leitura quebra o build.
    Pra rodar sem o portão: dotnet build -p:PularPortaoDeApis=true
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Buzzy.PortaoApis\Buzzy.PortaoApis.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net10.0"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="PortaoDeApisProibidas" AfterTargets="Build" Condition="'$(PularPortaoDeApis)' != 'true'">
    <PropertyGroup>
      <_BuzzyPortao>$(MSBuildThisFileDirectory)..\..\tools\Buzzy.PortaoApis\bin\$(Configuration)\net10.0\Buzzy.PortaoApis.dll</_BuzzyPortao>
    </PropertyGroup>
    <!--
      Autocontido: o runtime na pasta de saída só passa se nome e SHA-256 batem com os pacotes
      de runtime do SDK, e só dos dois frameworks usados.
    -->
    <ItemGroup Condition="'$(SelfContained)' == 'true'">
      <_BuzzyPacoteDeRuntime Include="@(ResolvedRuntimePack)"
                             Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' Or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <PropertyGroup Condition="'$(SelfContained)' == 'true'">
      <_BuzzyRuntimes>@(_BuzzyPacoteDeRuntime->'--runtime &quot;%(PackageDirectory)&quot;', ' ')</_BuzzyRuntimes>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_BuzzyPortao)&quot; --binarios &quot;$(OutDir).&quot; $(_BuzzyRuntimes) --fonte &quot;$(MSBuildThisFileDirectory).&quot; --fonte &quot;$(MSBuildThisFileDirectory)..\Buzzy.Core&quot; --fonte &quot;$(MSBuildThisFileDirectory)..\Buzzy.Visual&quot; --manifesto &quot;$(MSBuildThisFileDirectory)app.manifest&quot;"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8" />
  </Target>

  <!--
    Portão no .exe único, depois do publish: compara o host com o singlefilehost.exe do SDK, lê
    os assemblies de dentro do pacote e confere a procedência do resto e o manifesto embutido.
  -->
  <Target Name="PortaoDoPacoteDeArquivoUnico" AfterTargets="Publish"
          Condition="'$(PularPortaoDeApis)' != 'true' And '$(PublishSingleFile)' == 'true'">
    <!-- Item com outro nome: os do alvo do build ainda existem aqui e duplicariam os pacotes. -->
    <ItemGroup>
      <_BuzzyPacoteDeRuntimeDoPacote Include="@(ResolvedRuntimePack)"
                                     Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' Or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_BuzzyPortao>$(MSBuildThisFileDirectory)..\..\tools\Buzzy.PortaoApis\bin\$(Configuration)\net10.0\Buzzy.PortaoApis.dll</_BuzzyPortao>
      <_BuzzyRuntimes>@(_BuzzyPacoteDeRuntimeDoPacote->'--runtime &quot;%(PackageDirectory)&quot;', ' ')</_BuzzyRuntimes>
    </PropertyGroup>
    <Error Condition="'@(_BuzzyPacoteDeRuntimeDoPacote)' == ''" Text="Sem os pacotes de runtime do .NET e do WindowsDesktop para a procedência do portão." />
    <Error Condition="!Exists('$(SingleFileHostSourcePath)')" Text="O singlefilehost.exe do SDK não foi encontrado: $(SingleFileHostSourcePath)" />
    <Exec Command="dotnet &quot;$(_BuzzyPortao)&quot; --pacote &quot;$(PublishDir)$(AssemblyName).exe&quot; --host-de-arquivo-unico &quot;$(SingleFileHostSourcePath)&quot; $(_BuzzyRuntimes) --fonte &quot;$(MSBuildThisFileDirectory).&quot; --fonte &quot;$(MSBuildThisFileDirectory)..\Buzzy.Core&quot; --fonte &quot;$(MSBuildThisFileDirectory)..\Buzzy.Visual&quot; --manifesto &quot;$(MSBuildThisFileDirectory)app.manifest&quot;"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8" />
  </Target>

  <!--
    Validação do manifesto de clipes, depois de cada build: situação sem clipe, pose ou cara que
    não existe na arte, ou alfa fora de 0 e 255 quebram o build. Como no portão, a referência só
    garante a compilação antes. Pra rodar sem ela: dotnet build -p:PularValidacaoDeClipes=true
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Buzzy.ValidadorDeClipes\Buzzy.ValidadorDeClipes.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="ValidacaoDoManifestoDeClipes" AfterTargets="Build" Condition="'$(PularValidacaoDeClipes)' != 'true'">
    <PropertyGroup>
      <_BuzzyValidadorDeClipes>$(MSBuildThisFileDirectory)..\..\tools\Buzzy.ValidadorDeClipes\bin\$(Configuration)\net10.0-windows\Buzzy.ValidadorDeClipes.dll</_BuzzyValidadorDeClipes>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_BuzzyValidadorDeClipes)&quot; --manifesto &quot;$(MSBuildThisFileDirectory)Apresentacao\clipes.json&quot;"
          StdOutEncoding="utf-8"
          StdErrEncoding="utf-8" />
  </Target>

</Project>
