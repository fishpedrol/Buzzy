<Project Sdk="Microsoft.NET.Sdk">

  <!-- Arte do Buzzy: lê as partes (subconjunto de SVG) e as poses (JSON) e compõe os quadros
       com WPF no DPI pedido. Nada de sistema além do WPF, nem pacotes. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Buzzy.Visual</RootNamespace>
    <AssemblyName>Buzzy.Visual</AssemblyName>
  </PropertyGroup>

</Project>
