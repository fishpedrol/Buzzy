<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Executor de testes mínimo do Buzzy, sem nenhum pacote NuGet. Existe no lugar de MSTest
    ou xUnit porque o metapacote MSTest 4.0.2 traz Microsoft.Testing.Extensions.Telemetry e
    Microsoft.ApplicationInsights como dependências, e o projeto não usa telemetria nem
    pacotes de terceiros (DECISIONS.md, decisão sobre testes da Fase 1).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Buzzy.Testes</RootNamespace>
    <AssemblyName>Buzzy.Testes.Executor</AssemblyName>
  </PropertyGroup>

</Project>
