<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="Buzzy.App.Testes.app" />

  <!--
    Manifesto do executável de testes do aplicativo (fora do produto).

    asInvoker: os testes não pedem elevação. O Buzzy recusa rodar elevado e herdaria a
    elevação de um teste elevado; por isso os testes de integração também conferem isso
    antes de abrir o Buzzy.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e Windows 11, como o Buzzy.exe. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    Per-Monitor V2, como o Buzzy.exe. Sem isto, o Windows entrega a este processo coordenadas
    virtualizadas (escaladas) nos monitores com escala diferente de 100%, e elas não batem
    com o log de diagnóstico do Buzzy, que está em pixels físicos.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>

</assembly>
