<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verificação sintética dos critérios [MANUAL] da Fase 1 que dá para exercitar sem uma
    pessoa: abre o Buzzy.exe e um receptor de teste próprio, injeta cliques e teclas por
    SendInput (permitido só em ferramentas de teste fora do executável, SECURITY.md 3.2) e
    confere os resultados pelos logs. Todo input é rotulado como sintético.
    Abre janelas e move o cursor: só rodar depois de avisar o usuário. Sem a opção explícita
    de injetar input na tela (ver Programa.cs), só imprime o uso e sai com código 2.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Buzzy.Verificacao</RootNamespace>
    <AssemblyName>Buzzy.Verificacao</AssemblyName>
    <StartupObject>Buzzy.Verificacao.Programa</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!--
      Per-Monitor V2 e asInvoker no manifesto, como o Buzzy.exe: cliques, testes de acerto e
      pontos do log do Buzzy ficam todos em pixels físicos.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Buzzy.Core\Buzzy.Core.csproj" />
  </ItemGroup>

  <!--
    Perfil de teste (Fase 5): a pasta do perfil e a limpeza dela são as do próprio Buzzy e as dos testes de
    integração, compiladas junto, e não uma cópia: o que a verificação apaga é o que Buzzy.App.Testes testa.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Buzzy.App\Plataforma\PastaDeDados.cs" Link="Compartilhado\PastaDeDados.cs" />
    <Compile Include="..\Buzzy.App.Testes\Integracao\PerfilDeTeste.cs" Link="Compartilhado\PerfilDeTeste.cs" />
    <!-- A leitura do log que atravessa a rotação (marca com assinatura), a mesma dos testes de integração. -->
    <Compile Include="..\Buzzy.App.Testes\Integracao\LeituraDoLog.cs" Link="Compartilhado\LeituraDoLog.cs" />
    <!-- A foto, só por fora, dos arquivos reais de configuração do usuário, antes e depois: a mesma da integração. -->
    <Compile Include="..\Buzzy.App.Testes\Integracao\ArquivosReais.cs" Link="Compartilhado\ArquivosReais.cs" />
    <Compile Include="..\Buzzy.App.Testes\Integracao\RegistroReal.cs" Link="Compartilhado\RegistroReal.cs" />
  </ItemGroup>

  <!--
    Tamagotchi (DEC-028): as sementes dos cenários com a agenda ligada são escolhidas pelo simulador de tempo dos testes do
    núcleo, compilado junto (o mesmo arquivo, não uma cópia), e a ordem dos quadros de uso vem da pixel art.
  -->
  <ItemGroup>
    <Compile Include="..\Buzzy.Core.Testes\Movimento\SimuladorDeTempo.cs" Link="Compartilhado\SimuladorDeTempo.cs" />
    <!-- A semente em que o primeiro sorteio da paranoia sai (V17b e V17): a mesma escolha do teste de integração dela. -->
    <Compile Include="..\Buzzy.App.Testes\Integracao\SementesDaParanoia.cs" Link="Compartilhado\SementesDaParanoia.cs" />
    <!-- A semente em que a primeira decisão é o baseado por conta própria (V19): a mesma escolha do teste de integração dele. -->
    <Compile Include="..\Buzzy.App.Testes\Integracao\SementesDoBaseado.cs" Link="Compartilhado\SementesDoBaseado.cs" />
    <ProjectReference Include="..\..\src\Buzzy.Visual\Buzzy.Visual.csproj" />
  </ItemGroup>

</Project>
