<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roda depois de cada build do app, como o portão de APIs. Lê o clipes.json com o leitor estrito,
    confere que toda situação tem clipe e que poses e caras existem na arte, e desenha cada quadro
    com cada cara e deformação possível checando alfa só 0 ou 255. Desenha fora da tela.
    Saída: 0 ok, 1 com problemas, 2 erro de uso ou leitura.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Buzzy.ValidadorDeClipes</RootNamespace>
    <AssemblyName>Buzzy.ValidadorDeClipes</AssemblyName>
    <StartupObject>Buzzy.ValidadorDeClipes.Programa</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Buzzy.Visual\Buzzy.Visual.csproj" />
  </ItemGroup>

</Project>
