<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Portão de APIs proibidas: roda depois de cada build do app e reprova se achar uma
    capacidade proibida nos assemblies, nas importações nativas, no fonte ou no manifesto.
    Só lê os arquivos, nunca carrega nem executa. Sem pacote NuGet.
    Uso em Opcoes.Uso (Portao.cs). Saída: 0 ok, 1 violações, 2 erro de uso ou leitura.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Buzzy.PortaoApis</RootNamespace>
    <AssemblyName>Buzzy.PortaoApis</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Buzzy.PortaoApis.Testes" />
  </ItemGroup>

</Project>
