<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gera as prévias em assets/identidade/previa/ a partir de buzzy-partes.svg e buzzy-poses.json,
    e confere se cada pose cabe no quadro e só usa partes que existem. Renderiza fora da tela.
    Ferramenta de dev, não vai no produto.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Buzzy.Identidade</RootNamespace>
    <AssemblyName>Buzzy.Identidade</AssemblyName>
    <StartupObject>Buzzy.Identidade.Programa</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Buzzy.Visual\Buzzy.Visual.csproj" />
  </ItemGroup>

</Project>
