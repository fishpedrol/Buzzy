<Project>

  <!--
    Configuração comum de src/, tests/ e tools/ (cada uma importa daqui pelo seu
    Directory.Build.props). spikes/ não herda.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Não usamos pacote NuGet, mas lockfile e auditoria ficam ligados pra qualquer
      pacote futuro entrar fixado e auditado. NU1900 (auditoria sem rede) não vira erro.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Restore falha se o lockfile precisar mudar: pacote novo não entra em silêncio. -->
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
