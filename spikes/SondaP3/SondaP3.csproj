<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harness descartável do teste de arraste, fora do produto. Usa SendInput, que só é
    aceito em ferramenta de teste; o BuzzySpike em si não usa. Sem pacote NuGet.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>SondaP3</AssemblyName>
    <RootNamespace>SondaP3</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
