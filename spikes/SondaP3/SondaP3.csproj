<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harness DESCARTÁVEL de P3 (Etapa 0B). Não é código de produto e não segue para a Fase 1.
    Injeta input sintético (SendInput), o que SECURITY.md 3.2 permite apenas em ferramentas
    de teste fora do executável. O protótipo BuzzySpike continua sem SendInput.
    Nenhum pacote NuGet.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>SondaP3</AssemblyName>
    <RootNamespace>SondaP3</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
